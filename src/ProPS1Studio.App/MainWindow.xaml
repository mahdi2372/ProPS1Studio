<Window x:Class="ProPS1Studio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ProPS1 Studio"
        Height="780"
        Width="1240"
        MinHeight="620"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource StrokeSoftBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="212" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ============ Title bar (custom, chrome-enabled) ============ -->
            <Grid Grid.ColumnSpan="2" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                            Margin="14,0,0,0"
                            VerticalAlignment="Center">
                    <Ellipse Width="8"
                             Height="8"
                             Fill="{StaticResource AccentGradientBrush}"
                             Effect="{StaticResource LogoGlow}"
                             VerticalAlignment="Center" />
                    <TextBlock Text="ProPS1 Studio"
                               Margin="9,0,0,0"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="{Binding VersionText}"
                               Margin="8,0,0,0"
                               Style="{StaticResource Caption}" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}"
                            Width="44"
                            Height="36"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="11"
                            Content="&#xE921;"
                            ToolTip="Minimize"
                            Click="OnMinimizeClick" />
                    <Button Style="{StaticResource CaptionButton}"
                            Width="44"
                            Height="36"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="11"
                            Content="&#xE922;"
                            ToolTip="Maximize"
                            Click="OnMaximizeClick" />
                    <Button x:Name="CloseButton"
                            Style="{StaticResource CaptionClose}"
                            Width="44"
                            Height="36"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="11"
                            Content="&#xE8BB;"
                            ToolTip="Close"
                            Click="OnCloseClick" />
                </StackPanel>
            </Grid>

            <!-- ============ Sidebar ============ -->
            <Border Grid.Row="1"
                    Grid.Column="0"
                    Background="{StaticResource SidebarGradientBrush}"
                    BorderBrush="{StaticResource StrokeSoftBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="16,18,16,12" Orientation="Horizontal">
                        <Border Width="34"
                                Height="34"
                                CornerRadius="10"
                                Background="{StaticResource AccentGradientBrush}"
                                Effect="{StaticResource LogoGlow}">
                            <TextBlock Text="PS"
                                       FontSize="13.5"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ProPS1 Studio"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="PowerShell → EXE studio"
                                       Margin="0,2,0,0"
                                       Style="{StaticResource Caption}"
                                       FontSize="11" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Grid.Row="1"
                               Text="MENU"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextDimBrush}"
                               Opacity="0.7"
                               Margin="19,6,0,6" />

                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding NavItems}"
                             SelectedItem="{Binding SelectedNavItem, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             Margin="8,0,8,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="15"
                                               Width="24"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource AccentBrush}" />
                                    <TextBlock Text="{Binding Label}"
                                               Margin="4,0,0,0"
                                               FontSize="13.5"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="3"
                            BorderBrush="{StaticResource HairlineBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="16,10">
                        <TextBlock Text="{Binding StatusText}"
                                   Style="{StaticResource Caption}"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>
                </Grid>
            </Border>

            <!-- ============ Content ============ -->
            <Border Grid.Row="1"
                    Grid.Column="1"
                    Background="{StaticResource ContentGradientBrush}">
                <ContentControl Content="{Binding CurrentViewModel}"
                                Margin="20,16,20,16"
                                Focusable="False" />
            </Border>

            <!-- ============ Accent hairline under title bar ============ -->
            <Border Grid.Row="0"
                    Grid.ColumnSpan="2"
                    Height="1"
                    VerticalAlignment="Bottom"
                    Background="{StaticResource HairlineBrush}" />
        </Grid>
    </Border>
</Window>
