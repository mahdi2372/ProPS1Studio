<UserControl x:Class="ProPS1Studio.App.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False">
        <StackPanel>

            <!-- Header -->
            <DockPanel Margin="0,0,0,14">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Command="{Binding OpenToolsCommand}" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="Tools folder" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="Refresh" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Setup" FontSize="22" FontWeight="Bold" />
                    <TextBlock Text="Required and optional tools used by the conversion pipeline."
                               Style="{StaticResource Caption}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- ps2exe card -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ps2exe" FontSize="15.5" FontWeight="SemiBold" />
                            <Border Background="{StaticResource AccentDimBrush}" CornerRadius="9" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="REQUIRED" FontSize="10" Foreground="{StaticResource AccentBrush}" />
                            </Border>
                            <Border Background="{StaticResource SuccessBgBrush}" CornerRadius="9" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Ps2exeStatus.Installed}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="INSTALLED" FontSize="10" Foreground="{StaticResource SuccessBrush}" />
                            </Border>
                            <Border Background="{StaticResource DangerBgBrush}" CornerRadius="9" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Ps2exeStatus.Installed}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="MISSING" FontSize="10" Foreground="{StaticResource DangerBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="PowerShell module that compiles .ps1 scripts to .exe. Installed from PSGallery."
                                   Style="{StaticResource Caption}"
                                   Margin="0,6,0,0" />
                        <TextBlock Text="{Binding Ps2exeStatus.Version, Mode=OneWay, TargetNullValue=Version not detected}"
                                   FontSize="12.5"
                                   Margin="0,8,0,0" />
                        <TextBlock Text="{Binding Ps2exeStatus.Location, TargetNullValue=Location not detected}"
                                   Style="{StaticResource Caption}"
                                   FontFamily="Consolas"
                                   FontSize="11.5"
                                   Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Ps2exeStatus.Details}"
                                   Style="{StaticResource Caption}"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Button Command="{Binding InstallPs2exeCommand}"
                                Content="Install ps2exe"
                                Padding="18,9">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource ButtonAccent}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Ps2exeStatus.Installed}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- UPX card -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="UPX" FontSize="15.5" FontWeight="SemiBold" />
                            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="9" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="OPTIONAL" FontSize="10" Foreground="{StaticResource TextDimBrush}" />
                            </Border>
                            <Border Background="{StaticResource SuccessBgBrush}" CornerRadius="9" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UpxStatus.Installed}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="INSTALLED" FontSize="10" Foreground="{StaticResource SuccessBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Executable packer (v5.2.1, hash-pinned). Shrinks unpacked binaries; skipped automatically for .NET assemblies."
                                   Style="{StaticResource Caption}"
                                   Margin="0,6,0,0" />
                        <TextBlock Text="{Binding UpxStatus.Version, Mode=OneWay, TargetNullValue=Not installed}"
                                   FontSize="12.5"
                                   Margin="0,8,0,0" />
                        <TextBlock Text="{Binding UpxStatus.Location, TargetNullValue=Download it from the tools folder when needed}"
                                   Style="{StaticResource Caption}"
                                   FontFamily="Consolas"
                                   FontSize="11.5"
                                   Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding UpxStatus.Details}"
                                   Style="{StaticResource Caption}"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Button Command="{Binding InstallUpxCommand}"
                                Content="Install UPX">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource ButtonAccent}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UpxStatus.Installed}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Status line -->
            <Border Style="{StaticResource CardTight}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    <TextBlock Text="Checking...">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Caption}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
