<UserControl x:Class="ProPS1Studio.App.Views.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False">
        <StackPanel>

            <!-- Header -->
            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="Help" FontSize="22" FontWeight="Bold" />
                <TextBlock Text="How ProPS1 Studio works, and where to get more information."
                           Style="{StaticResource Caption}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <!-- What it does -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="What this app does" Style="{StaticResource SectionHeader}" />
                    <TextBlock TextWrapping="Wrap" FontSize="13.5" LineHeight="21">
                        <Run Text="ProPS1 Studio compiles PowerShell scripts (.ps1) into standalone Windows executables using the open-source " />
                        <Run Text="ps2exe" FontWeight="SemiBold" />
                        <Run Text=" module. Optionally it compresses the result with " />
                        <Run Text="UPX" FontWeight="SemiBold" />
                        <Run Text=", embeds a UAC manifest so the exe requests administrator rights, optionally encrypts the script source inside the exe, scans the script for secrets before compiling, and signs the output with Authenticode." />
                        <Run Text=" The BAT → EXE page does the same for batch files (.bat/.cmd), compiled directly with the bundled .NET Framework csc.exe — no ps2exe or Setup needed." />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Quick steps -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Quick start" Style="{StaticResource SectionHeader}" />
                    <TextBlock Text="1.  Open Setup and confirm ps2exe is installed (green INSTALLED badge)." Margin="0,2,0,0" FontSize="13.5" />
                    <TextBlock Text="2.  On Convert, browse to your .ps1 script — the output path is derived automatically." Margin="0,4,0,0" FontSize="13.5" />
                    <TextBlock Text="3.  Tick Run as administrator and Compress with UPX if you need them." Margin="0,4,0,0" FontSize="13.5" />
                    <TextBlock Text="4.  Press Convert. The result card shows the output path, size, and any warnings." Margin="0,4,0,0" FontSize="13.5" />
                    <TextBlock Text="5.  If something goes wrong, export a diagnostics bundle from the Diagnostics page."
                               Margin="0,4,0,0" FontSize="13.5" />
                </StackPanel>
            </Border>

            <!-- BAT to EXE quick start -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="BAT → EXE quick start" Style="{StaticResource SectionHeader}" />
                    <TextBlock Text="1.  Open BAT → EXE and browse to your .bat or .cmd file — the output path is derived automatically." Margin="0,2,0,0" FontSize="13.5" />
                    <TextBlock Text="2.  Pick an execution level, console behaviour, and optionally bundle extra files next to the extracted script." Margin="0,4,0,0" FontSize="13.5" />
                    <TextBlock Text="3.  Press Convert. The compiler is bundled, so no Setup step is required for this page." Margin="0,4,0,0" FontSize="13.5" />
                </StackPanel>
            </Border>

            <!-- Notes -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Good to know" Style="{StaticResource SectionHeader}" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="23" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource WarnBrush}" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="13" Style="{StaticResource Caption}">
                            <Run Text="UPX cannot compress .NET assemblies. The app detects this automatically, compiles normally, and adds a warning instead of failing." />
                        </TextBlock>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="23" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource WarnBrush}" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="13" Style="{StaticResource Caption}">
                            <Run Text="Your script is never executed by the app — only compiled. Sign in to: " />
                            <Run Text="Settings → Authenticode signing" />
                            <Run Text=". The PFX password comes from the PROPS_SIGN_PFX_PASSWORD environment variable, never from disk." />
                        </TextBlock>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="23" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource WarnBrush}" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="13" Style="{StaticResource Caption}">
                            <Run Text="A BAT → EXE passphrase only XOR-obfuscates the embedded payload — the key lives inside the executable. It hides the source from casual viewing, it is not copy protection." />
                        </TextBlock>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="23" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource WarnBrush}" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="13" Style="{StaticResource Caption}">
                            <Run Text="Secret scanning masks findings in reports and logs — the raw value is never written anywhere." />
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Links -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Links &amp; documentation" Style="{StaticResource SectionHeader}" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Command="{Binding OpenDocsCommand}" Content="User guide" Margin="0,0,10,0" />
                        <Button Command="{Binding OpenPs2exeCommand}" Content="ps2exe on GitHub" Margin="0,0,10,0" />
                        <Button Command="{Binding OpenUpxCommand}" Content="UPX on GitHub" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource CardTight}">
                <StackPanel>
                    <TextBlock Text="{Binding VersionText}" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="Developed by Mahdi"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               Margin="0,6,0,0" />
                    <TextBlock Text="Built on ps2exe (MS-PL 1.1) by Markus Scholtes and UPX (GPLv2) by the UPX team."
                               Style="{StaticResource Caption}"
                               Margin="0,6,0,0" />
                    <TextBlock Text="Open-source licenses are reproduced in the docs/licenses folder."
                               Style="{StaticResource Caption}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
