<UserControl x:Class="ProPS1Studio.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False">
        <StackPanel>

            <!-- Header -->
            <DockPanel Margin="0,0,0,14">
                <Button DockPanel.Dock="Right"
                        Command="{Binding RefreshCommand}"
                        VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Text="Refresh" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="Dashboard" FontSize="22" FontWeight="Bold" />
                    <TextBlock Text="{Binding ProbeStatus}" Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Caption}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProbing}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </DockPanel>

            <!-- Environment cards -->
            <UniformGrid Columns="4" Margin="0,0,0,16">
                <Border Style="{StaticResource CardTight}" Margin="0,0,8,8">
                    <StackPanel>
                        <TextBlock Text="OPERATING SYSTEM" Style="{StaticResource Caption}" FontSize="10.5" />
                        <TextBlock Text="{Binding OsSummary}" Margin="0,3,0,0" FontSize="12.5" />
                        <TextBlock Text="{Binding MachineSummary}" Margin="0,2,0,0" Style="{StaticResource Caption}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardTight}" Margin="0,0,8,8">
                    <StackPanel>
                        <TextBlock Text="POWERSHELL" Style="{StaticResource Caption}" FontSize="10.5" />
                        <TextBlock Text="{Binding PowerShellSummary}" Margin="0,3,0,0" FontSize="12.5" />
                        <TextBlock Text="{Binding ElevationSummary}" Margin="0,2,0,0" Style="{StaticResource Caption}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardTight}" Margin="0,0,8,8">
                    <StackPanel>
                        <TextBlock Text="PS2EXE" Style="{StaticResource Caption}" FontSize="10.5" />
                        <TextBlock Text="{Binding Ps2exeSummary}" Margin="0,3,0,0" FontSize="12.5">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Ps2exeReady}" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding UpxSummary}" Margin="0,2,0,0" Style="{StaticResource Caption}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardTight}" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="SYSTEM" Style="{StaticResource Caption}" FontSize="10.5" />
                        <TextBlock Text="{Binding InternetSummary}" Margin="0,3,0,0" FontSize="12.5" />
                        <TextBlock Text="{Binding DiskSummary}" Margin="0,2,0,0" Style="{StaticResource Caption}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Recent conversions -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Recent conversions" Style="{StaticResource SectionHeader}" />
                    <TextBlock Text="Everything you have compiled on this machine."
                               Style="{StaticResource Caption}"
                               Margin="0,-4,0,10" />
                    <ListBox ItemsSource="{Binding RecentConversions}"
                             Background="Transparent"
                             BorderThickness="0"
                             MaxHeight="330"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="16" VerticalAlignment="Center" Margin="2,0,10,0">
                                        <TextBlock Text="&#xE73E;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="15"
                                                   Foreground="{StaticResource SuccessBrush}"
                                                   HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Success}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="&#xE711;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="15"
                                                   Foreground="{StaticResource DangerBrush}"
                                                   HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Success}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding OutputPath, Mode=OneWay}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource Caption}" FontSize="11.5" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding InputPath, Mode=OneWay}" />
                                            <Run Text="·" />
                                            <Run Text="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}, Mode=OneWay}" />
                                            <Run Text="·" />
                                            <Run Text="{Binding OutputSizeBytes, StringFormat={}{0:n0} bytes, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <Border Background="{StaticResource AccentDimBrush}"
                                                CornerRadius="9"
                                                Padding="8,2"
                                                Margin="0,0,6,0">
                                            <Border.Style>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CompressedWithUpx}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="UPX" FontSize="10.5" Foreground="{StaticResource AccentBrush}" />
                                        </Border>
                                        <Border Background="{StaticResource WarnBgBrush}" CornerRadius="9" Padding="8,2">
                                            <Border.Style>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RequireAdministrator}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="ADMIN" FontSize="10.5" Foreground="{StaticResource WarnBrush}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="No conversions yet — open the Convert page to create your first executable."
                               Margin="0,6,0,0">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Caption}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RecentConversions.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
